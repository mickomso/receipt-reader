# Receipt Reader — Variables de entorno
# Copia este fichero a .env y rellena los valores

# ── xAI / Grok (desarrollo/pruebas gratuitas) ──────────────────────────────────
# Obtén tu clave gratuita en https://console.x.ai/
XAI_API_KEY=
GROK_MODEL=grok-4.5

# ── Selector de extractor: llm | grok ─────────────────────────────────────────
EXTRACTOR_BACKEND=llm

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/receipt_reader.db

# ── Ficheros ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# ── Servidor ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Validación ─────────────────────────────────────────────────────────────────
TOTALS_TOLERANCE_EUR=0.02
LINE_TOLERANCE_EUR=0.01

# ── CORS ───────────────────────────────────────────────────────────────────────
# Orígenes permitidos para el frontend (separados por coma en formato JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
